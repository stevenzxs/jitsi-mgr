# Environment
NODE_ENV=development

# Server
PORT=3000
HOST=127.0.0.1
TRUST_PROXY=true

# Database (开发环境使用 SQLite)
DATABASE_TYPE=sqlite
DATABASE_PATH=./data/jitsi-mgr.db

# Database (生产环境使用 PostgreSQL)
# DATABASE_TYPE=postgresql
# DATABASE_URL=postgresql://user:password@localhost:5432/jitsi_mgr

# JWT
JWT_PRIVATE_KEY_PATH=./secrets/jwt-private.pem
JWT_PUBLIC_KEY_PATH=./secrets/jwt-public.pem
JWT_ACCESS_TOKEN_EXPIRY=2h
JWT_REFRESH_TOKEN_EXPIRY=7d
JWT_ISSUER=cloudmeet-mgr
JWT_AUDIENCE=cloudmeet-client

# Security
BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION=900
PASSWORD_MIN_LENGTH=8

# Rate Limiting
RATE_LIMIT_REGISTER_MAX=10
RATE_LIMIT_REGISTER_WINDOW=3600000
RATE_LIMIT_LOGIN_MAX=20
RATE_LIMIT_LOGIN_WINDOW=3600000
RATE_LIMIT_API_MAX=1000
RATE_LIMIT_API_WINDOW=3600000

# Logging
LOG_LEVEL=info

# Admin (用于初始化管理员)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_EMAIL=admin@example.com
